{
  "title": "Fullstack App Overview",
  "uid": "fullstack-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total requests",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(flask_http_request_total)" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Requests per second by method and status",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum by (method, status) (rate(flask_http_request_total[1m]))", "legendFormat": "{{method}} {{status}}" } ]
    },
    {
      "id": 3, "type": "logs", "title": "App logs (fullstack-dev)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{namespace=\"fullstack-dev\"}" } ]
    }
  ]
}
